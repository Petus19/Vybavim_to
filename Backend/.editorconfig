root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,props,csproj,slnx,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true

# CA1716: názvy ako "Error" sú kľúčové slová vo Visual Basic – píšeme iba v C#, netýka sa nás
dotnet_diagnostic.CA1716.severity = none

# Testy: názvy v tvare Metóda_Situácia_Výsledok (napr. Create_EmptyTitle_Throws) používajú podčiarkovníky
[Tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Migrácie generuje EF Core (dotnet ef) – analyzátory ich nekontrolujú
[**/Migrations/*.cs]
generated_code = true
