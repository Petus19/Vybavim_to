<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spoločný technický kód (DB, auth, udalosti, chyby). Žiadna biznis logika. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + ovládač pre PostgreSQL. Moduly ich dostanú automaticky cez referenciu na Common. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- C# názvy (CategoryId) → názvy v databáze (category_id) -->
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>
</Project>
