# Template for local settings used by docker-compose.yml.
# If a port is already taken on your machine, copy this file to .env
# (macOS/Linux: cp .env.example .env, Windows: copy .env.example .env) and change the port.
# .env is not committed – everyone keeps their own.

# PostgreSQL (if you change it, also update Backend/Api/appsettings.Development.json)
DB_PORT=5432

# Redis
REDIS_PORT=6379

# RustFS (S3 API and web console)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Mailpit (SMTP and web UI)
SMTP_PORT=2525
MAILPIT_PORT=8025
