# Vzor lokálnych nastavení pre docker-compose.yml.
# Ak je niektorý port na tvojom počítači obsadený, skopíruj tento súbor do .env
# (macOS: cp .env.example .env, Windows: copy .env.example .env) a zmeň port.
# Súbor .env je mimo gitu, každý si ho upravuje sám.

# PostgreSQL
DB_PORT=5432

# Redis
REDIS_PORT=6379

# RustFS (S3 API a webová konzola)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Mailpit (SMTP a webové rozhranie)
SMTP_PORT=2525
MAILPIT_PORT=8025
