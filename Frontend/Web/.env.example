# Adresa backendového API. Web ho volá zo servera (nie z prehliadača).
# Lokálne: cd Backend && dotnet run --project Api
API_URL=http://localhost:5080

# Prihlásenie cez Google (Google Cloud Console → Google Auth Platform → Clients).
# Client secret je tajný – patrí iba do .env.local, nikdy do gitu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
