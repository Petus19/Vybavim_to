# Backend API address. The web app calls it from the server (never from the browser).
# Locally: cd Backend && dotnet run --project Api
API_URL=http://localhost:5080

# Optional: sign in with Google (Google Cloud Console → Google Auth Platform → Clients).
# The client secret is secret – put it only in .env.local, never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
